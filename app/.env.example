# Copy to app/.env. Optional: without these the app reads everything from the server's HTTP API.
# Supabase project URL and the PUBLISHABLE key (never the secret key; that one stays in server/.env).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional: the Triagent server, when it isn't on port 8080 of the machine serving the bundle.
# EXPO_PUBLIC_API_URL=http://192.168.1.20:8080
