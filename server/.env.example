# Triagent server configuration. Copy to server/.env and fill in. Never commit .env.

# Elasticsearch holding the dcsim data streams.
ES_URL=http://localhost:9200
# Optional: API key for a secured cluster (Elastic Cloud). Leave empty for the local docker-compose cluster.
ES_API_KEY=

# NVIDIA hosted API (OpenAI-compatible). Keys from build.nvidia.com.
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# NVIDIA issues one key per model. Put each model's key on its role's line.
# A role left empty falls back to NVIDIA_API_KEY.
# Key for the TRIAGENT_MODEL_INVESTIGATOR model:
NVIDIA_API_KEY_INVESTIGATOR=
# Key for the TRIAGENT_MODEL_CRITIC model:
NVIDIA_API_KEY_CRITIC=
# Key for the TRIAGENT_MODEL_SMALL model (same key as the critic if both use the same model):
NVIDIA_API_KEY_SMALL=
# Fallback for any role above that is empty.
NVIDIA_API_KEY=

# Model ids. Must start with nvidia/nemotron (challenge rule). Swapping a model is an env change.
# Investigator: tool use, long context, reasoning on.
TRIAGENT_MODEL_INVESTIGATOR=nvidia/nemotron-3.5-super-vl-120b-a12b
# Critic: no-tools review of the report, reasoning on.
TRIAGENT_MODEL_CRITIC=nvidia/nemotron-3.5-lightning-30b-a3b
# Remediation writer and push-notification summarizer, reasoning off.
TRIAGENT_MODEL_SMALL=nvidia/nemotron-3.5-lightning-30b-a3b

# Tool-call budget per investigation (search, aggregate, ..., note_finding and submit_report all count).
TRIAGENT_MAX_TOOL_CALLS=20

# Critic review with one investigator retry on fail (1 = on, 0 = off).
TRIAGENT_CRITIC=1

# Local experiments only: allow non-Nemotron model ids. Never set this for the demo or the scorer.
# TRIAGENT_ALLOW_ANY_MODEL=1

# Optional: where finished jobs are written (default <repo>/t/jobs).
# TRIAGENT_JOBS_DIR=
# Optional: log level (default INFO).
# LOG_LEVEL=INFO
